<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AudioVisualPlayer.App.FolderDialog"
        Title="Выбор папки с музыкой" Width="660" Height="520"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Border Classes="card" Margin="16" Padding="18">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Где лежит музыка?" FontSize="20" FontWeight="Bold" />
        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                   Text="Укажи папку — плеер просканирует её вместе со всеми вложенными папками. Поддерживаются MP3, FLAC, WAV, AIFF, APE, M4A, OGG, WMA." />
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
        <TextBox x:Name="PathBox" PlaceholderText="Например: F:\Музыка" />
        <Button x:Name="BrowseBtn" Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" />
      </Grid>
      <TextBlock x:Name="ValidateLabel" Grid.Row="2" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
      <TextBlock Grid.Row="3" Classes="h1" Text="НЕДАВНИЕ ПАПКИ" Margin="0,14,0,6" />
      <ListBox x:Name="RecentList" Grid.Row="4" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="5" Classes="dim" FontSize="11" Margin="0,10,0,0"
                 Text="Двойной клик по недавней папке подставляет её в поле выше." />
      <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
        <Button x:Name="CancelBtn" Content="Отмена" />
        <Button x:Name="OkBtn" Classes="primary" Content="Сканировать папку" IsEnabled="False" />
      </StackPanel>
    </Grid>
  </Border>
</Window>