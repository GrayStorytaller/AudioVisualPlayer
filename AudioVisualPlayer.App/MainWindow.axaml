<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:AudioVisualPlayer.Core"
        xmlns:controls="using:AudioVisualPlayer.App.Controls"
        xmlns:local="using:AudioVisualPlayer.App"
        x:Class="AudioVisualPlayer.App.MainWindow"
        Title="PulseDeck"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        SystemDecorations="BorderOnly"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <local:LosslessToBrush x:Key="LosslessBrush" />
  </Window.Resources>

  <Grid x:Name="RootGrid" RowDefinitions="44,Auto,*,Auto">
    <!-- Кастомный тайтлбар -->
    <Border x:Name="TitleBar" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource SurfaceColor}" />
          <GradientStop Offset="1" Color="{DynamicResource BgColor}" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="6">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#FF3D81" />
                <GradientStop Offset="1" Color="#22D3EE" />
              </LinearGradientBrush>
            </Border.Background>
            <Path Stretch="Uniform" Margin="5" Fill="#0B0E14"
                  Data="M2,8 H4 V12 H2 Z M6,5 H8 V15 H6 Z M10,2 H12 V18 H10 Z M14,6 H16 V14 H14 Z M18,4 H20 V16 H18 Z" />
          </Border>
          <TextBlock Text="PULSEDECK" FontSize="13" FontWeight="ExtraBold" LetterSpacing="2" VerticalAlignment="Center" />
          <TextBlock Text="C# · Avalonia · NAudio" Classes="dim" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="TitleTrack" Grid.Column="1" Classes="dim" FontSize="11"
                   TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="MinBtn" Classes="win" ToolTip.Tip="Свернуть">
            <Path Width="12" Height="12" Stretch="Uniform" Data="M3,10 H17 V11.6 H3 Z" />
          </Button>
          <Button x:Name="MaxBtn" Classes="win" ToolTip.Tip="Развернуть / восстановить">
            <Grid Width="12" Height="12">
              <Path x:Name="MaxIcon" Stretch="Uniform" Data="M3,3 H17 V17 H3 Z M4.6,4.6 V15.4 H15.4 V4.6 Z" />
              <Path x:Name="RestoreIcon" Stretch="Uniform" IsVisible="False"
                    Data="M6,6 H17 V17 H6 Z M7.6,7.6 V15.4 H15.4 V7.6 Z M3,3 H14 V6 H12.4 V4.6 H4.6 V12.4 H3 Z" />
            </Grid>
          </Button>
          <Button x:Name="CloseBtn" Classes="win close" ToolTip.Tip="Закрыть">
            <Path Width="12" Height="12" Stretch="Uniform"
                  Data="M4,3 L10,9 L16,3 L17,4 L11,10 L17,16 L16,17 L10,11 L4,17 L3,16 L9,10 L3,4 Z" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Шапка библиотеки -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="chip" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" MaxWidth="420" ToolTip.Tip="{Binding #FolderPathLabel.Text}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Data="M1,4 H6 L8,6 H15 V13 H1 Z" />
            <TextBlock x:Name="FolderPathLabel" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button x:Name="FolderBtn" Content="Сменить папку" />
      </StackPanel>
      <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="170" VerticalAlignment="Center" />
    </Grid>

    <!-- Контент -->
    <Grid Grid.Row="2" ColumnDefinitions="320,*,300" Margin="12,0">
      <Border Classes="card" Padding="14" Margin="0,0,12,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <DockPanel>
            <TextBlock Classes="h1" Text="БИБЛИОТЕКА" VerticalAlignment="Center" />
            <TextBlock x:Name="CountLabel" Classes="dim" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Поиск: артист, название…" Margin="0,10,0,8" />
          <ComboBox x:Name="SortBox" Grid.Row="2" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,0,8">
            <ComboBoxItem>Сортировка: артист</ComboBoxItem>
            <ComboBoxItem>Сортировка: название</ComboBoxItem>
            <ComboBoxItem>Сортировка: длительность</ComboBoxItem>
            <ComboBoxItem>Сортировка: битрейт</ComboBoxItem>
          </ComboBox>
          <ListBox x:Name="TrackList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:TrackInfo">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding DurationText}" Classes="dim" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="{Binding Album}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                  <Border Grid.Row="1" Grid.Column="1" Classes="chip" Margin="0,2,0,0"
                          Background="{Binding IsLossless, Converter={StaticResource LosslessBrush}}">
                    <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BgBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ScanStatus" Grid.Row="4" Classes="dim" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="0,0,12,0">
        <Border Classes="card" Padding="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock x:Name="NowTitle" Text="Выбери трек двойным кликом" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="NowArtist" Classes="dim" FontSize="12" Text="Библиотека сканируется…" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="chip" Background="{DynamicResource SurfaceAltBrush}">
                <TextBlock x:Name="NowFormatText" Text="—" FontSize="10" FontWeight="Bold" />
              </Border>
              <Border Classes="chip" Background="{DynamicResource AccentBrush}">
                <TextBlock x:Name="NowBitrateText" Text="—" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BgBrush}" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card" ClipToBounds="True" Margin="0,12,0,12">
          <controls:SpectrumVisualizer x:Name="Viz" Margin="10" />
        </Border>
        <TextBlock x:Name="StatusLabel" Grid.Row="2" Classes="dim" FontSize="11" Text="Готов к работе." />
      </Grid>

      <Border Grid.Column="2" Classes="card" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Classes="h1" Text="VISUAL LAB" />
            <TextBlock Classes="dim" FontSize="11" Text="Палитра полос" />
            <ComboBox x:Name="PaletteBox" SelectedIndex="0" HorizontalAlignment="Stretch">
              <ComboBoxItem>Градиент темы</ComboBoxItem>
              <ComboBoxItem>Спектр (радуга)</ComboBoxItem>
              <ComboBoxItem>Моно (акцент)</ComboBoxItem>
            </ComboBox>

            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Полосы" FontSize="12" /><TextBlock x:Name="BarsVal" Grid.Column="1" Classes="dim" FontSize="12" /></Grid>
            <Slider x:Name="BarsSlider" Minimum="16" Maximum="96" Value="48" TickFrequency="4" IsSnapToTickEnabled="True" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Чувствительность" FontSize="12" /><TextBlock x:Name="GainVal" Grid.Column="1" Classes="dim" FontSize="12" /></Grid>
            <Slider x:Name="GainSlider" Minimum="0.5" Maximum="3" Value="1.2" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Плавность спада" FontSize="12" /><TextBlock x:Name="DecayVal" Grid.Column="1" Classes="dim" FontSize="12" /></Grid>
            <Slider x:Name="DecaySlider" Minimum="0.70" Maximum="0.97" Value="0.88" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Свечение" FontSize="12" /><TextBlock x:Name="GlowVal" Grid.Column="1" Classes="dim" FontSize="12" /></Grid>
            <Slider x:Name="GlowSlider" Minimum="0" Maximum="1" Value="0.6" />

            <CheckBox x:Name="MirrorChk" Content="Зеркало" />
            <CheckBox x:Name="PeaksChk" Content="Пики" IsChecked="True" />
            <CheckBox x:Name="RoundedChk" Content="Скругление" IsChecked="True" />
            <CheckBox x:Name="GridChk" Content="Сетка" IsChecked="True" />

            <Grid ColumnDefinitions="*,*">
              <Button x:Name="ResetLabBtn" Content="Сброс" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
              <Button x:Name="RandomLabBtn" Grid.Column="1" Content="Рандом" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Classes="h1" Text="СКИН" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="swatch" Tag="#FF3D81" Background="#FF3D81" Click="Swatch_Click" />
              <Button Classes="swatch" Tag="#22D3EE" Background="#22D3EE" Click="Swatch_Click" />
              <Button Classes="swatch" Tag="#FFB020" Background="#FFB020" Click="Swatch_Click" />
              <Button Classes="swatch" Tag="#A3E635" Background="#A3E635" Click="Swatch_Click" />
              <Button Classes="swatch" Tag="#60A5FA" Background="#60A5FA" Click="Swatch_Click" />
              <Button Classes="swatch" Tag="#F43F5E" Background="#F43F5E" Click="Swatch_Click" />
            </StackPanel>
            <Button x:Name="SaveThemeBtn" Content="Сохранить скин (JSON)" HorizontalAlignment="Stretch" />
            <TextBlock Classes="dim" FontSize="10" TextWrapping="Wrap"
                       Text="Скины лежат в папке themes рядом с exe и подхватываются при запуске." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Транспорт -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" CornerRadius="16" Padding="14" Margin="12,12,12,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="PrevBtn" Classes="icon" ToolTip.Tip="Предыдущий трек">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                  Data="M3,2 H5 V14 H3 Z M13,2 L6,8 L13,14 Z" />
          </Button>
          <Button x:Name="PlayBtn" Classes="primary icon" Width="52" Height="52" CornerRadius="26" ToolTip.Tip="Играть / пауза">
            <Grid Width="18" Height="18">
              <Path x:Name="PlayIcon" Stretch="Uniform" Fill="{DynamicResource BgBrush}" Data="M4,2 L14,8 L4,14 Z" />
              <Path x:Name="PauseIcon" Stretch="Uniform" Fill="{DynamicResource BgBrush}" IsVisible="False" Data="M4,2 H7 V14 H4 Z M9,2 H12 V14 H9 Z" />
            </Grid>
          </Button>
          <Button x:Name="NextBtn" Classes="icon" ToolTip.Tip="Следующий трек">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                  Data="M11,2 H13 V14 H11 Z M3,2 L10,8 L3,14 Z" />
          </Button>
          <Button x:Name="StopBtn" Classes="icon" ToolTip.Tip="Стоп">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Data="M4,4 H12 V12 H4 Z" />
          </Button>
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,8" />
          <Button x:Name="ShuffleBtn" Classes="icon" ToolTip.Tip="Случайный порядок: выкл">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z" />
          </Button>
          <Button x:Name="RepeatBtn" Classes="icon" ToolTip.Tip="Повтор: выкл">
            <Grid Width="16" Height="16">
              <Path x:Name="RepeatIcon" Stretch="Uniform"
                    Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z" />
              <Path x:Name="RepeatOneIcon" Stretch="Uniform" IsVisible="False"
                    Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-4-2V9h-1l-2 1v1h1.5v4H13z" />
            </Grid>
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">
          <TextBlock x:Name="TimeNow" Text="00:00" Classes="dim" FontSize="11" Width="42" VerticalAlignment="Center" />
          <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center" />
          <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="00:00" Classes="dim" FontSize="11" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="VOL" Classes="dim" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
          <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" />
          <TextBlock x:Name="TrackIndex" Classes="dim" FontSize="11" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>